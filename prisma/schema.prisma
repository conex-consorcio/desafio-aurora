generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Parceiro {
  id        String   @id @default(uuid())
  codigo    String   @unique
  documento String
  criadoEm  DateTime @default(now())

  @@map("parceiros")
}

/// PENDENTE: reservado antes da chamada ao parceiro, sem protocolo.
/// REGISTRADO: o parceiro confirmou e devolveu o protocolo.
enum SituacaoLance {
  PENDENTE
  REGISTRADO
}

model Lance {
  id           String        @id @default(uuid())
  grupo        String
  cota         String
  assembleia   String
  situacao     SituacaoLance @default(PENDENTE)
  protocolo    String?
  reservadoEm  DateTime      @default(now())
  registradoEm DateTime?

  @@unique([grupo, cota, assembleia])
  @@map("lances")
}

model Cota {
  id            String    @id @default(uuid())
  grupo         String
  numero        String
  situacao      String
  valorCredito  Int?
  sincronizadaEm DateTime?

  @@unique([grupo, numero])
  @@map("cotas")
}
