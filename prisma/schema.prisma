generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Parceiro {
  id        String   @id @default(uuid())
  codigo    String   @unique
  documento String
  criadoEm  DateTime @default(now())

  @@map("parceiros")
}

model ChaveIdempotencia {
  id        String   @id @default(uuid())
  chave     String   @unique
  status    String   @default("PENDENTE")
  resultado Json?
  erro      String?
  criadoEm  DateTime @default(now())

  @@map("chaves_idempotencia")
}

model Lance {
  id          String   @id @default(uuid())
  grupo       String
  cota        String
  assembleia  String
  protocolo   String?
  registradoEm DateTime @default(now())

  @@unique([grupo, cota, assembleia])
}

model Cota {
  id            String    @id @default(uuid())
  grupo         String
  numero        String
  situacao      String
  valorCredito  Int?
  sincronizadaEm DateTime?

  @@map("cotas")
}
