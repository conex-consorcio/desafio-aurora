DATABASE_URL="postgresql://aurora:aurora@localhost:5442/aurora?schema=public&connection_limit=10"
REDIS_URL="redis://localhost:6389"

AURORA_BASE_URL="http://localhost:4010"
AURORA_CLIENT_ID="parceiro-demo"
AURORA_CLIENT_SECRET="dev-secret-nao-usar-em-producao"
AURORA_INTEGRADOR="plataforma"

# Limite de concorrencia GLOBAL (compartilhado entre instancias via Redis),
# por debaixo do limite do parceiro (20). Lease = timeout + 1s.
AURORA_LIMITE_GLOBAL=16
AURORA_LEASE_MS=11000

PORT=3010
